{
	"useTabs": true,
	"singleQuote": true,
	"trailingComma": "all",
	"printWidth": 100,
	"plugins": ["prettier-plugin-svelte", "prettier-plugin-tailwindcss"],
	"overrides": [
		{ "files": "*.svelte", "options": { "parser": "svelte" } },
		{ "files": ["*.yml", "*.yaml", "*.md"], "options": { "useTabs": false } }
	],
	"tailwindStylesheet": "./apps/web/src/app.css"
}
