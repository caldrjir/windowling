# Copy to .env for local development: cp .env.example .env
# Never commit real secrets. Production values live in Cloudflare (wrangler secret) / GitHub secrets.

# PostgreSQL connection string (matches docker-compose.yml).
DATABASE_URL=postgres://windowling:windowling@localhost:5432/windowling

# Used only by the database integration tests. Defaults to DATABASE_URL's server with the windowling_test DB.
TEST_DATABASE_URL=postgres://windowling:windowling@localhost:5432/windowling_test

# Better Auth. Generate a secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Base URL Better Auth uses for callbacks (no trailing slash).
BETTER_AUTH_URL=http://localhost:5173

# Google OAuth (optional locally - the Google button is hidden when unset).
# Authorized redirect URI: http://localhost:5173/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# The character's cloud brain: any OpenAI-compatible chat API (optional - unset = canned reactions).
# Local Ollama: AI_API_URL=http://localhost:11434/v1 and AI_MODEL=llama3.2
# Workers AI:   AI_API_URL=https://api.cloudflare.com/client/v4/accounts/<account id>/ai/v1
#               AI_API_KEY=<API token with Workers AI: Read>
AI_API_URL=
AI_API_KEY=
AI_MODEL=
# LLM calls per player per UTC day (protects the free tier).
AI_DAILY_LIMIT=60

# Public URL of the app (exposed to the browser).
PUBLIC_APP_URL=http://localhost:5173
