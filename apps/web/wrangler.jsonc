{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "windowling",
	// Not a secret: identifies the Cloudflare account that owns windowling.com.
	"account_id": "e4d21a54530afdeb8db4fc66a1338b18",
	// The site gate (src/worker) wraps the SvelteKit worker built by adapter-cloudflare.
	"main": "src/worker/index.ts",
	"alias": { "sveltekit-worker": "./.svelte-kit/cloudflare/_worker.js" },
	"compatibility_date": "2026-09-01",
	// postgres.js needs Node's net/tls APIs (served by Workers TCP sockets).
	"compatibility_flags": ["nodejs_compat"],
	"assets": {
		"binding": "ASSETS",
		"directory": ".svelte-kit/cloudflare",
		// Every request (static games included) passes the site gate first.
		"run_worker_first": true,
	},
	"observability": { "enabled": true },
	"vars": {
		"PUBLIC_APP_URL": "https://windowling.com",
		"BETTER_AUTH_URL": "https://windowling.com",
		// The whole site is behind one shared password (secret SITE_PASSWORD_HASH).
		"SITE_GATE": "on",
	},
	// Secrets (never in this file): DATABASE_URL, BETTER_AUTH_SECRET, SITE_PASSWORD_HASH,
	// GOOGLE_CLIENT_ID, GOOGLE_CLIENT_SECRET - uploaded by the Deploy workflow from the
	// GitHub `production` environment (see docs/development.md#deployment).
	// www is served by the same Worker and 301-redirected to the apex (hooks.server.ts).
	"routes": [
		{ "pattern": "windowling.com", "custom_domain": true },
		{ "pattern": "www.windowling.com", "custom_domain": true },
	],
	// DRIFTWOOD multiplayer: one Durable Object per world (WebSockets) and one lobby
	// listing the worlds being played. SQLite-backed (available on the free plan).
	"durable_objects": {
		"bindings": [
			{ "name": "DRIFTWOOD_ROOM", "class_name": "DriftwoodRoom" },
			{ "name": "DRIFTWOOD_LOBBY", "class_name": "DriftwoodLobby" },
		],
	},
	"migrations": [{ "tag": "v1", "new_sqlite_classes": ["DriftwoodRoom", "DriftwoodLobby"] }],
	// Cloudflare Hyperdrive in front of Neon (pooling, fast connects). Query caching is
	// disabled on purpose: player data must never be served stale. When bound, it takes
	// precedence over DATABASE_URL in production. `localConnectionString` is only used by
	// `wrangler dev` (E2E) and points at the Docker Compose database - not a secret.
	"hyperdrive": [
		{
			"binding": "HYPERDRIVE",
			"id": "97c48d6c97ca431b88735921eaeb5fa5",
			"localConnectionString": "postgres://windowling:windowling@localhost:5432/windowling",
		},
	],
}
